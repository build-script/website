---
import type { MarkdownHeading } from "astro";
import Base from "./Base.astro";
import DocsNav from "../components/DocsNav.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { DOCS, REPOSITORIES, type Doc } from "../data/docs";
import { docCommit, docHref } from "../lib/docs";
import { fitStyle } from "../lib/fit";
import { HOME } from "../lib/paths";

interface Props {
    doc: Doc;
    /** the first heading of the doc */
    title: string;
    headings: MarkdownHeading[];
}

const { doc, title, headings } = Astro.props;

const index = DOCS.indexOf(doc);
const previous = DOCS[index - 1];
const next = DOCS[index + 1];
const sections = headings.filter((heading) => heading.depth === 2);

const repository = REPOSITORIES[doc.repository];
const commit = docCommit(doc.repository);
const source = `${repository.url}/blob/${commit}/${doc.path}`;
---

<Base title={doc.slug === "" ? "build-script docs" : `${title} · build-script docs`} description={doc.description}>
    <Header current="docs" />
    <main id="main" class="docs grid-lines">
        <div class="page docs-layout">
            <details class="docs-menu">
                <summary><span class="label">Docs</span> {doc.label} <span class="docs-menu-mark" aria-hidden="true">↘</span></summary>
                <nav aria-label="Docs">
                    <DocsNav current={doc.slug} />
                </nav>
            </details>

            <nav class="docs-sidebar" aria-label="Docs">
                <DocsNav current={doc.slug} />
            </nav>

            <article class="docs-article">
                <header class="docs-header">
                    <p class="label"><span class="docs-group">{doc.group}</span> / {doc.label}</p>
                    <h1 class="docs-title display fit" style={fitStyle([title])}>{title}</h1>
                    <p class="docs-source">
                        From <a href={source} target="_blank" rel="noopener noreferrer">{repository.name}, {doc.path} at {commit.slice(0, 7)}<span class="visually-hidden"> (opens in a new tab)</span></a>
                    </p>
                </header>

                <div class="prose">
                    <slot />
                </div>

                <nav class="docs-pager" aria-label="Previous and next doc">
                    {previous && (
                        <a class="docs-pager-link" href={docHref(previous.slug, HOME)} rel="prev">
                            <span class="label">Previous</span>
                            <span class="docs-pager-title">{previous.label}</span>
                        </a>
                    )}
                    {next && (
                        <a class="docs-pager-link docs-pager-next" href={docHref(next.slug, HOME)} rel="next">
                            <span class="label">Next</span>
                            <span class="docs-pager-title">{next.label} <span aria-hidden="true">→</span></span>
                        </a>
                    )}
                </nav>
            </article>

            {sections.length > 1 && (
                <nav class="docs-toc" aria-label="On this page">
                    <p class="label">On this page</p>
                    <ul>
                        {sections.map((section) => (
                            <li><a href={`#${section.slug}`}>{section.text}</a></li>
                        ))}
                    </ul>
                </nav>
            )}
        </div>
    </main>
    <Footer />
</Base>

<style>
    .docs {
        position: relative;
        padding-block: var(--space-8) var(--space-9);
    }

    .docs-layout {
        position: relative;
        display: grid;
        grid-template-columns: 14rem minmax(0, 1fr) 13rem;
        gap: var(--space-8);
        align-items: start;
    }

    .docs-menu {
        display: none;
    }

    .docs-sidebar,
    .docs-toc {
        position: sticky;
        top: var(--space-6);
        max-height: calc(100vh - 2 * var(--space-6));
        overflow-y: auto;
    }

    .docs-article {
        min-width: 0;
        max-width: 48rem;
    }

    .docs-header {
        display: grid;
        gap: var(--space-4);
        padding-bottom: var(--space-6);
        border-bottom: 1px solid var(--color-line);
        container-type: inline-size;
    }

    .docs-group {
        color: var(--color-signal);
    }

    /* a long title breaks between words, never inside one */
    .docs-title {
        --fit-size: var(--font-size-section);
        --fit-width: var(--fit-word);
        white-space: normal;
    }

    .docs-source {
        font-size: var(--font-size-small);
        color: var(--color-muted);
    }

    .docs-source a {
        color: var(--color-muted);
    }

    .docs-source a:hover {
        color: var(--color-signal);
    }

    .docs-toc ul {
        display: grid;
        gap: var(--space-2);
        margin: var(--space-3) 0 0;
        padding: 0;
        list-style: none;
    }

    .docs-toc a {
        font-size: var(--font-size-small);
        color: var(--color-muted);
        text-decoration: none;
    }

    .docs-toc a:hover {
        color: var(--color-text);
    }

    .docs-pager {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
        margin-top: var(--space-9);
    }

    .docs-pager-link {
        display: grid;
        gap: var(--space-2);
        padding: var(--space-4) var(--space-5);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: var(--color-surface);
        text-decoration: none;
        transition: border-color 160ms linear, box-shadow 160ms linear;
    }

    .docs-pager-link:hover {
        border-color: var(--color-signal);
        box-shadow: var(--glow-signal);
    }

    .docs-pager-next {
        grid-column: 2;
        text-align: right;
    }

    .docs-pager-title {
        font-family: var(--font-display);
        font-size: 1.125rem;
        font-weight: 900;
        letter-spacing: var(--tracking-display);
        text-transform: uppercase;
    }

    /* the Markdown of the docs, rendered by src/lib/markdown.ts */
    .prose {
        padding-top: var(--space-6);
        overflow-wrap: anywhere;
        /* its tables ask how wide it is */
        container: prose / inline-size;
    }

    .prose > :global(* + *) {
        margin-top: var(--space-5);
    }

    .prose :global(h2) {
        margin-top: var(--space-9);
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
        font-weight: 900;
        line-height: var(--line-height-display);
        letter-spacing: var(--tracking-display);
        text-transform: uppercase;
        scroll-margin-top: var(--space-6);
    }

    .prose :global(h3),
    .prose :global(h4) {
        margin-top: var(--space-7);
        font-size: 1.0625rem;
        font-weight: 700;
        scroll-margin-top: var(--space-6);
    }

    .prose :global(h2 + *),
    .prose :global(h3 + *),
    .prose :global(h4 + *) {
        margin-top: var(--space-4);
    }

    .prose :global(a) {
        color: var(--color-text);
        text-decoration-color: var(--color-signal);
    }

    .prose :global(a:hover) {
        color: var(--color-signal);
    }

    .prose :global(strong) {
        font-weight: 700;
    }

    .prose :global(ul),
    .prose :global(ol) {
        display: grid;
        /* the items as wide as the list, not as their longest line */
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-2);
        padding-left: var(--space-5);
    }

    .prose :global(ul) {
        list-style: square;
    }

    .prose :global(li::marker) {
        color: var(--color-signal);
    }

    .prose :global(:not(pre) > code) {
        padding: 0.1em 0.35em;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: var(--color-surface);
        font-size: 0.875em;
        /* a frame on every line when it breaks */
        -webkit-box-decoration-break: clone;
        box-decoration-break: clone;
    }

    /* the words of inline code, see src/lib/markdown.ts: whole unless one is wider than the line. break-word and not
       anywhere: a column of a table stays as wide as its widest word */
    .prose :global(.code-word) {
        display: inline-block;
        max-width: 100%;
        overflow-wrap: break-word;
    }

    .prose :global(pre.code) {
        padding: var(--space-5) var(--space-4);
        overflow-x: auto;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        background: var(--color-surface);
        font-size: var(--font-size-small);
        line-height: 1.7;
        overflow-wrap: normal;
    }

    .prose :global(.table-scroll) {
        overflow-x: auto;
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--font-size-small);
        overflow-wrap: normal;
    }

    .prose :global(th),
    .prose :global(td) {
        padding: var(--space-2) var(--space-3);
        border-bottom: 1px solid var(--color-line);
        text-align: left;
        vertical-align: top;
    }

    .prose :global(th) {
        background: var(--color-surface);
        font-size: var(--font-size-label);
        font-weight: 400;
        letter-spacing: var(--tracking-label);
        text-transform: uppercase;
        color: var(--color-muted);
    }

    .prose :global(tr:last-child td) {
        border-bottom: none;
    }

    .prose :global(blockquote) {
        padding-left: var(--space-4);
        border-left: 2px solid var(--color-signal);
        color: var(--color-muted);
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--color-line);
    }

    @media (max-width: 79.99rem) {
        .docs-layout {
            grid-template-columns: 13rem minmax(0, 1fr);
        }

        .docs-toc {
            display: none;
        }
    }

    /* the navigation folds into a menu above the doc */
    @media (max-width: 63.99rem) {
        .docs {
            padding-top: var(--space-5);
        }

        .docs-layout {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-6);
        }

        .docs-sidebar {
            display: none;
        }

        .docs-menu {
            display: block;
            border: 1px solid var(--color-line);
            border-radius: var(--radius);
            background: var(--color-surface);
        }

        .docs-menu summary {
            display: flex;
            align-items: center;
            gap: var(--space-3);
            padding: var(--space-3) var(--space-4);
            font-size: var(--font-size-small);
            cursor: pointer;
            list-style: none;
        }

        .docs-menu summary::-webkit-details-marker {
            display: none;
        }

        .docs-menu-mark {
            margin-left: auto;
            color: var(--color-signal);
        }

        .docs-menu[open] .docs-menu-mark {
            transform: rotate(180deg);
        }

        .docs-menu nav {
            padding: var(--space-2) var(--space-4) var(--space-5);
            border-top: 1px solid var(--color-line);
        }

        .docs-article {
            max-width: none;
        }
    }

    @media (max-width: 40rem) {
        .docs-pager {
            grid-template-columns: minmax(0, 1fr);
        }

        .docs-pager-next {
            grid-column: 1;
        }
    }

    /* Where a table has no room, every row becomes a card: its first cell on top, the others below with the name of
       their column. The room is the width of the text, not of the window: two columns fit down to 36rem, three and
       more need 48rem. The same rules twice, a container query takes no list of conditions per selector. */
    @container prose (max-width: 35.99rem) {
        .prose :global(.table-scroll) {
            overflow: visible;
            border: none;
        }

        .prose :global(.table-scroll :is(table, tbody, tr, td)) {
            display: block;
        }

        .prose :global(.table-scroll thead) {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        .prose :global(.table-scroll tr) {
            padding: var(--space-3) var(--space-4);
            border: 1px solid var(--color-line);
            border-radius: var(--radius);
        }

        .prose :global(.table-scroll tr + tr) {
            margin-top: var(--space-3);
        }

        .prose :global(.table-scroll td) {
            padding: 0;
            border: none;
        }

        .prose :global(.table-scroll td:empty) {
            display: none;
        }

        .prose :global(.table-scroll td + td) {
            margin-top: var(--space-2);
            color: var(--color-muted);
        }

        .prose :global(.table-scroll td + td[data-label]::before) {
            content: attr(data-label);
            display: block;
            margin-bottom: var(--space-1);
            font-size: var(--font-size-label);
            letter-spacing: var(--tracking-label);
            text-transform: uppercase;
        }
    }

    @container prose (max-width: 47.99rem) {
        .prose :global(.table-wide) {
            overflow: visible;
            border: none;
        }

        .prose :global(.table-wide :is(table, tbody, tr, td)) {
            display: block;
        }

        .prose :global(.table-wide thead) {
            position: absolute;
            width: 1px;
            height: 1px;
            overflow: hidden;
            clip-path: inset(50%);
        }

        .prose :global(.table-wide tr) {
            padding: var(--space-3) var(--space-4);
            border: 1px solid var(--color-line);
            border-radius: var(--radius);
        }

        .prose :global(.table-wide tr + tr) {
            margin-top: var(--space-3);
        }

        .prose :global(.table-wide td) {
            padding: 0;
            border: none;
        }

        .prose :global(.table-wide td:empty) {
            display: none;
        }

        .prose :global(.table-wide td + td) {
            margin-top: var(--space-2);
            color: var(--color-muted);
        }

        .prose :global(.table-wide td + td[data-label]::before) {
            content: attr(data-label);
            display: block;
            margin-bottom: var(--space-1);
            font-size: var(--font-size-label);
            letter-spacing: var(--tracking-label);
            text-transform: uppercase;
        }
    }
</style>
