---
import type { TerminalSession } from "../data/terminal";
import { escapeHtml } from "../lib/html";

interface Props {
    session: TerminalSession;
    caption: string;
}

const { session, caption } = Astro.props;

// built here and not in the template: whitespace inside <pre> counts
const directory = `<span class="terminal-directory">${escapeHtml(session.directory)}</span>`;
const steps = session.steps.map((step) => {
    const prompt = `<span class="terminal-prompt">${directory} <span aria-hidden="true">$</span> <span class="terminal-command" data-command="${escapeHtml(step.command)}">${escapeHtml(step.command)}</span></span>`;
    const lines = step.lines.map((line) => {
        const module = line.module === undefined ? "" : `<span class="terminal-module">[${escapeHtml(line.module)}]</span> `;
        return `<span class="terminal-line" data-pause="${line.pause}">${module}${escapeHtml(line.text)}</span>`;
    });

    return `<span class="terminal-step" data-step>${prompt}${lines.join("")}</span>`;
});
const body = steps.join("") + `<span class="terminal-cursor" aria-hidden="true"></span>`;
---

<figure class="terminal contour" data-terminal>
    <div class="terminal-bar">
        <span class="terminal-dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="terminal-title">{session.directory}</span>
    </div>
    <!-- the end state, which the script replays line by line; without it, or without motion, it stays like this -->
    <pre class="terminal-body"><code set:html={body} /></pre>
    <figcaption class="visually-hidden">{caption}</figcaption>
</figure>

<script>
    import { replayTerminals } from "../scripts/terminal";

    replayTerminals();
</script>

<style>
    .terminal {
        margin: 0;
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
    }

    .terminal-bar {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding: var(--space-3) var(--space-4);
        border-bottom: 1px solid var(--color-line);
    }

    .terminal-dots {
        display: flex;
        gap: 6px;
    }

    .terminal-dots i {
        width: 9px;
        height: 9px;
        border: 1px solid var(--color-muted);
        border-radius: 1px;
    }

    .terminal-dots i:first-child {
        border-color: var(--color-signal);
        background: var(--color-signal);
    }

    .terminal-title {
        font-size: var(--font-size-label);
        letter-spacing: 0.06em;
        color: var(--color-muted);
    }

    .terminal-body {
        min-height: 22.5rem;
        padding: var(--space-5) var(--space-4) var(--space-6);
        overflow-x: auto;
        font-size: var(--font-size-small);
        line-height: 1.85;
        color: var(--color-muted);
    }

    .terminal-body :global(.terminal-step) {
        display: block;
    }

    .terminal-body :global(.terminal-step + .terminal-step) {
        margin-top: var(--space-4);
    }

    .terminal-body :global(.terminal-prompt) {
        display: block;
        color: var(--color-text);
    }

    .terminal-body :global(.terminal-directory) {
        color: var(--color-muted);
    }

    .terminal-body :global(.terminal-line) {
        display: block;
        white-space: pre;
    }

    /* build-script prints the names of modules in orange */
    .terminal-body :global(.terminal-module) {
        color: var(--color-signal);
    }

    .terminal-body :global(.terminal-line.is-pending),
    .terminal-body :global(.terminal-step.is-pending) {
        display: none;
    }

    .terminal-body :global(.terminal-cursor) {
        display: inline-block;
        width: 0.6em;
        height: 1.15em;
        margin-left: 2px;
        vertical-align: text-bottom;
        background: var(--color-text);
        animation: blink 1.1s steps(1) infinite;
    }

    @media (max-width: 47.99rem) {
        .terminal-body {
            min-height: 19rem;
            font-size: var(--font-size-label);
        }
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }
</style>
